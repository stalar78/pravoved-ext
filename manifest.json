{
  "manifest_version": 3,
  "name": "Pravoved Case Assistant",
  "version": "0.1.5",
  "description": "Расширение для извлечения кейсов с pravoved.ru и локальной работы с вложениями.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pravoved.ru/*",
        "https://www.pravoved.ru/*"
      ],
      "js": [
        "src/download/page-fetch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pravoved.ru/*",
        "https://www.pravoved.ru/*"
      ],
      "js": [
        "src/utils/text.js",
        "src/extractor/selectors.js",
        "src/extractor/metadata.js",
        "src/extractor/question.js",
        "src/extractor/answers.js",
        "src/extractor/attachments.js",
        "src/extractor/next-data.js",
        "src/formatter/chatgpt.js",
        "src/storage/status.js",
        "src/storage/chat-files.js",
        "src/download/zip.js",
        "src/chat/attachments.js",
        "src/ui/panel.js",
        "src/ui/chat-panel.js",
        "src/content.js",
        "src/chat/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
